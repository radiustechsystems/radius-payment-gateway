# radius-gateway settings for docker compose. Every setting the README lists works here.

# Your API, as reachable from inside the container. An API on the Docker host is
# http://host.docker.internal:<port>; a service in the same compose file is http://<service>:<port>.
UPSTREAM=http://host.docker.internal:3000

# Radius Platform: an organization API key with endpoints:read, and the project.
PLATFORM_API_KEY=sk_...
ORGANIZATION_ID=org_...
PROJECT_ID=00000000-0000-7000-8000-000000000000

# The URL buyers reach you at: the base of resource.url in challenges and of the page's assets.
PUBLIC_URL=https://api.example.com

# Optional: a name on the payment page.
# BRAND=Example API
# BRAND_URL=https://example.com

# Optional: a directory of page files overriding the built-in ones (mount it; see docker-compose.yml).
# PAGES_DIR=/pages

# Optional: logging.
# LOG_FORMAT=json
# RUST_LOG=info,radius_gateway=debug
